GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Opcional: defina se a detecção automática escolher o IP de rede incorreto.
# PUBLIC_FRONTEND_URL=http://192.168.1.25:5173
PORT=3000
NODE_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vitalhelp_v2
MYSQL_USER=vitalhelp_app
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-local-password
